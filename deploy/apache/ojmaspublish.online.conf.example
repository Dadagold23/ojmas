<VirtualHost *:80>
    ServerName ojmaspublish.online
    ServerAlias www.ojmaspublish.online
    Redirect permanent / https://ojmaspublish.online/
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName ojmaspublish.online
    ServerAlias www.ojmaspublish.online

    DocumentRoot /path/to/ojmas-journal/public

    <Directory /path/to/ojmas-journal/public>
        AllowOverride All
        Require all granted
    </Directory>

    SSLEngine on
    SSLCertificateFile /path/to/fullchain.pem
    SSLCertificateKeyFile /path/to/privkey.pem

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    ErrorLog ${APACHE_LOG_DIR}/ojmaspublish-error.log
    CustomLog ${APACHE_LOG_DIR}/ojmaspublish-access.log combined

    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.ojmaspublish\.online$ [NC]
    RewriteRule ^ https://ojmaspublish.online%{REQUEST_URI} [L,R=301,NE]
</VirtualHost>
</IfModule>
